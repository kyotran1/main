# ─────────────────────────────────────────────────────────────────────────────
# ADS-NOLIMIT AI OFFICE – Giao diện Web (Vite + React)
# Sao chép thành apps/web/.env.local (Vite chỉ nạp biến có tiền tố VITE_ vào trình duyệt).
# Tên biến là định danh kỹ thuật – KHÔNG dịch. Giá trị dưới đây là mặc định.
# Nguồn: apps/web/vite.config.ts, apps/web/src/lib/api.ts, apps/web/src/lib/realtime.ts
# ─────────────────────────────────────────────────────────────────────────────

# Địa chỉ gốc của backend mà TRÌNH DUYỆT gọi trực tiếp (REST + Socket.IO).
# Bỏ trống = gọi cùng origin (/api, /socket.io) và để dev server/preview proxy sang backend.
# Chỉ đặt khi phục vụ giao diện từ máy chủ khác backend, ví dụ: http://192.168.1.10:4000
VITE_API_BASE_URL=

# Đích proxy của dev server (pnpm dev) và preview (pnpm preview) cho /api và /socket.io.
# Biến này chỉ dùng phía Node (vite.config.ts), không lộ ra trình duyệt.
# Kiểm thử e2e đặt http://127.0.0.1:4100 để trỏ tới backend tạm.
VITE_API_PROXY_TARGET=http://localhost:4000

# ── Biến dùng cho kiểm thử e2e (apps/web/e2e/run.mjs) – tùy chọn ──
# Có giá trị → dùng máy chủ đang chạy thay vì tự khởi động backend + preview.
# E2E_BASE_URL=http://localhost:5173
# Giới hạn danh sách tuyến đường cần kiểm tra (phân tách bằng dấu phẩy).
# E2E_ROUTES=/,/tasks,/approvals
# Đặt =1 để buộc dựng lại apps/web/dist trước khi chạy preview.
# E2E_BUILD=0
# Cổng tạm cho backend và preview khi runner tự khởi động.
# E2E_API_PORT=4100
# E2E_WEB_PORT=4173
# Đặt =0 để xem trình duyệt khi chạy (mặc định chạy ẩn).
# E2E_HEADLESS=1
