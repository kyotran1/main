# ─────────────────────────────────────────────────────────────────────────────
# ADS-NOLIMIT AI OFFICE – Backend cục bộ (Local Runtime)
# Sao chép thành apps/api/.env (hoặc đặt biến môi trường trước khi chạy).
# Tên biến là định danh kỹ thuật – KHÔNG dịch. Giá trị dưới đây là mặc định.
# Nguồn: apps/api/src/server.ts, apps/api/src/engine/providers/*.ts
# ─────────────────────────────────────────────────────────────────────────────

# Cổng HTTP mà backend lắng nghe (REST + Socket.IO).
PORT=4000

# Địa chỉ lắng nghe. 127.0.0.1 = chỉ máy này; đặt 0.0.0.0 nếu cần truy cập từ máy khác trong LAN.
HOST=127.0.0.1

# Origin được phép gọi API (CORS). Bỏ trống = cho phép tất cả (phù hợp chạy cục bộ).
# Ví dụ: CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=

# Đường dẫn file lưu trạng thái văn phòng (JSON). Mặc định: apps/api/data/office-state.json
# DATA_FILE=./data/office-state.json

# Đặt =1 để bỏ file trạng thái cũ và dựng lại dữ liệu mẫu tiếng Việt khi khởi động.
SEED_RESET=0

# Đặt =off để tắt mô phỏng tiến độ tự động của nhân sự AI (hữu ích khi kiểm thử e2e).
# Giá trị khác (hoặc bỏ trống) = bật mô phỏng.
SIMULATION=on

# Bộ não nhân sự AI: mock | ollama | anthropic
#   mock      – mô phỏng, không cần mạng hay khóa truy cập (mặc định)
#   ollama    – mô hình cục bộ (Local) qua Ollama
#   anthropic – Anthropic Claude trên đám mây (Cloud)
# Khi mô hình không khả dụng, hệ thống tự quay về mock để không bao giờ dừng.
AI_PROVIDER=mock

# ── Chỉ dùng khi AI_PROVIDER=ollama ──
# Địa chỉ máy chủ Ollama cục bộ.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tên mô hình Ollama (định danh kỹ thuật).
OLLAMA_MODEL=qwen2.5:14b

# ── Chỉ dùng khi AI_PROVIDER=anthropic ──
# Khóa API Anthropic (bí mật – KHÔNG commit giá trị thật vào kho mã).
ANTHROPIC_API_KEY=
# Hoặc token xác thực thay thế (nếu dùng gateway nội bộ).
# ANTHROPIC_AUTH_TOKEN=
# Tên mô hình Claude (định danh kỹ thuật).
ANTHROPIC_MODEL=claude-opus-5-5

# Thư mục bản build giao diện Web để Local Runtime phục vụ cùng origin (Desktop dùng). Mặc định apps/web/dist; "off" để tắt.
# WEB_DIST=../web/dist
