{
  "name": "@ads-nolimit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend cục bộ (Local Runtime) – nguồn dữ liệu duy nhất, điều phối nhân sự AI, đồng bộ thời gian thực",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ads-nolimit/i18n": "workspace:*",
    "@ads-nolimit/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
