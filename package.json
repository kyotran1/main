{
  "name": "ads-nolimit-ai-office",
  "version": "0.1.0",
  "private": true,
  "description": "ADS-NOLIMIT AI OFFICE – Trung tâm điều hành công ty AI (Hybrid Local + Cloud)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @ads-nolimit/api dev\" \"pnpm --filter @ads-nolimit/web dev\"",
    "dev:desktop": "pnpm --filter @ads-nolimit/desktop dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint:i18n": "tsx scripts/i18n-lint.ts",
    "glossary:docs": "tsx scripts/generate-glossary-doc.ts",
    "e2e": "pnpm --filter @ads-nolimit/web e2e",
    "check": "pnpm typecheck && pnpm lint:i18n && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5"
  }
}
